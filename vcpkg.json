{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "custom-game-launcher-backend",
  "version": "0.1.0",
  "description": "REST API server for the Custom Game Launcher",
  "homepage": "https://github.com/Ruy41321/Custom-Game-Launcher-Backend",
  "license": "MIT",
  "builtin-baseline": "39344dff01c5a5a0134caf2624cdd492f05d30ea",
  "dependencies": [
    {
      "name": "drogon",
      "features": ["orm", "postgres"]
    },
    "spdlog",
    "libsodium",
    "jwt-cpp",
    "openssl",
    {
      "name": "curl",
      "features": ["non-http", "openssl"]
    }
  ],
  "features": {
    "tests": {
      "description": "Build the automated test suite",
      "dependencies": ["gtest"]
    }
  }
}
