# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets with:
#   openssl rand -hex 32

LAUNCHER_ENV=development

# --- Database -------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=launcher
DB_USER=launcher
DB_PASSWORD=change-me

# --- API ------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=debug
LOG_JSON=false

# Admin surface. Bound to 127.0.0.1 inside the container by design; reach it through an
# SSH tunnel:  ssh -L 9090:127.0.0.1:9090 user@your-vps
ADMIN_ENABLED=false
ADMIN_PORT=9090

# --- Secrets (required outside development) -------------------------------
# Left blank on purpose. Outside development the server refuses to start on a blank one *and*
# on the placeholders docker-compose.yml falls back to, which are committed to a public
# repository and therefore secret from nobody. Generate your own:
#   openssl rand -base64 48
JWT_SECRET=
FILE_SECURE_LINK_SECRET=

# --- File server ----------------------------------------------------------
# Artwork lives under its own root because the file server publishes it unsigned; a public
# location over the build blobs would serve every game's files to anyone holding a hash.
MEDIA_ROOT=/data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8081/media
MEDIA_MAX_BYTES=5242880

BLOB_ROOT=/data/blobs
FILE_PUBLIC_BASE_URL=http://localhost:8081/files
SIGNED_URL_TTL=3600

# --- Launcher releases ----------------------------------------------------
# The public half of the key launcher releases are signed with, as the body of a PEM
# 'BEGIN PUBLIC KEY' block on one line. Empty - the default - means this deployment
# publishes no launcher releases at all, which is better than publishing ones nothing
# can check.
#
# The PRIVATE half does not belong here, on this machine, or in this repository's CI.
# A release is signed wherever it is built, and this server only ever verifies. That is
# what makes an attacker who owns this deployment able to stop updates and unable to
# forge one - see Documentation/hardening-and-deployment.md section 6.5.
#
#   openssl ecparam -name prime256v1 -genkey -noout -out release-signing.key
#   openssl ec -in release-signing.key -pubout -outform DER | openssl base64 -A
LAUNCHER_RELEASE_PUBLIC_KEY=
LAUNCHER_RELEASE_ROOT=/data/launcher
LAUNCHER_PUBLIC_BASE_URL=http://localhost:8081/launcher

# --- Authentication -------------------------------------------------------
# Off in development: there is no mail transport yet, so the verification link
# cannot be delivered. Must be true anywhere real.
REQUIRE_VERIFIED_EMAIL=false
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Argon2id cost. 0 selects libsodium's INTERACTIVE profile (~64 MiB per hash).
# Raise on a host with memory to spare; stored hashes upgrade themselves on the
# owner's next login.
ARGON2_OPSLIMIT=0
ARGON2_MEMLIMIT=0

# --- Rate limiting ---------------------------------------------------------
# Attempts per client address before login/registration/password-reset throttle.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=60

# Requests one *account* may make across every authenticated route, whatever address they
# arrive from. Loose on purpose: the busiest legitimate caller is a build upload, one request
# per chunk, and ten a second is faster than any real link fills them.
ACCOUNT_RATE_LIMIT_REQUESTS=600
ACCOUNT_RATE_LIMIT_WINDOW=60

# --- Mail ------------------------------------------------------------------
# Registration and password recovery both depend on a message arriving, so a deployed
# environment that cannot send one refuses to start rather than accepting registrations
# nobody can finish.
#
#   smtp  a real relay. The only value staging and production accept.
#   log   write the message to the log instead of sending it — development only, and refused
#         elsewhere, because the body of a reset message is a live credential.
#   none  this deployment sends no mail at all. Then REQUIRE_VERIFIED_EMAIL must be false and
#         the routes that would send answer 404.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls. starttls is the submission port's usual shape and is mandatory when
# selected: a relay that does not offer it fails the send rather than carrying credentials in
# the clear. Certificate verification is always on and has no switch — a private authority
# belongs in the image's trust store.
SMTP_SECURITY=starttls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Custom Game Launcher

# The origin the links in a message are built from. Configuration and never the request's
# Host header, which is chosen by whoever is calling: building the link from it would let a
# stranger pick the domain that appears in somebody else's inbox. It has to be an origin a
# browser can reach — the pages at /verify-email and /password-reset are served from here.
MAIL_LINK_BASE_URL=http://localhost:8080
MAIL_PRODUCT_NAME=Custom Game Launcher

# Bounds the whole SMTP conversation. A registration waits for it before it can tell the
# caller whether the message went out, so it is short.
MAIL_TIMEOUT=10

# The routes that put a message in somebody's inbox have their own bucket, per client
# address, and not the authentication one: that is tight because every attempt behind it
# costs an Argon2id hash, while these cost a stranger's inbox and the deployment's standing
# with its relay.
MAIL_RATE_LIMIT=3
MAIL_RATE_WINDOW=900

# --- Transport security ----------------------------------------------------
# Send Strict-Transport-Security. Leave it off until something actually terminates TLS in
# front of the API: browsers ignore the header over plain HTTP, but turning it on and then
# serving a machine over http://localhost pins that browser with no way back.
HSTS_ENABLED=false
HSTS_MAX_AGE=15552000

# Addresses whose X-Forwarded-For is believed, as a JSON array of plain addresses or IPv4
# CIDR blocks. Empty means every request is attributed to the peer that sent it — right for a
# server clients reach directly, and wrong the moment a TLS terminator sits in front, because
# every per-address limit then shares one bucket. For a proxy on the compose bridge:
#   TRUSTED_PROXIES=["172.16.0.0/12"]
TRUSTED_PROXIES=[]

# --- Limits ---------------------------------------------------------------
DEFAULT_UPLOAD_QUOTA_BYTES=5368709120
FULL_DOWNLOAD_THRESHOLD=0.7

# The largest document body any route accepts — in practice the manifest of a large build —
# and the tighter cap on a request carrying no bearer token.
MAX_DOCUMENT_BYTES=16777216
MAX_ANONYMOUS_BODY_BYTES=65536

# --- Host port mappings (compose only) ------------------------------------
API_HOST_PORT=8080
DB_HOST_PORT=5432
FILESERVER_HOST_PORT=8081
