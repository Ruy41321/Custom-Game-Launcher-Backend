# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets with:
#   openssl rand -hex 32

LAUNCHER_ENV=development

# --- Database -------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=launcher
DB_USER=launcher
DB_PASSWORD=change-me

# --- API ------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=debug
LOG_JSON=false

# Admin surface. Bound to 127.0.0.1 inside the container by design; reach it through an
# SSH tunnel:  ssh -L 9090:127.0.0.1:9090 user@your-vps
ADMIN_ENABLED=false
ADMIN_PORT=9090

# --- Secrets (required outside development) -------------------------------
JWT_SECRET=
FILE_SECURE_LINK_SECRET=

# --- File server ----------------------------------------------------------
BLOB_ROOT=/data/blobs
FILE_PUBLIC_BASE_URL=http://localhost:8081/files
SIGNED_URL_TTL=3600

# --- Limits ---------------------------------------------------------------
DEFAULT_UPLOAD_QUOTA_BYTES=5368709120
FULL_DOWNLOAD_THRESHOLD=0.7

# --- Host port mappings (compose only) ------------------------------------
API_HOST_PORT=8080
DB_HOST_PORT=5432
FILESERVER_HOST_PORT=8081
