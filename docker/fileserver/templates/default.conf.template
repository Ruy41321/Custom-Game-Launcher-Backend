# Read-only delivery of content-addressed build blobs.
#
# Download URLs are signed by the API and validated here with nginx's secure_link module:
# no callback to the API per chunk, and HTTP Range works natively so an interrupted
# download resumes instead of restarting. See CLAUDE.md section 3.
#
# The signature is  base64url( md5( "<expires><uri> <secret>" ) )  and is passed as
#   ?token=<signature>&expires=<unix timestamp>

server {
    listen      80;
    server_name _;

    server_tokens off;
    access_log  /var/log/nginx/access.log;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /files/ {
        secure_link     $arg_token,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${FILE_SECURE_LINK_SECRET}";

        # Empty means the signature did not verify; "0" means it verified but has expired.
        if ($secure_link = "") {
            return 403;
        }
        if ($secure_link = "0") {
            return 410;
        }

        alias /data/blobs/;

        # A blob is named after the hash of its own contents, so it can never change.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;

        default_type application/octet-stream;
        sendfile           on;
        tcp_nopush         on;
        max_ranges         64;
        autoindex          off;
    }

    # Game artwork. Public and unsigned on purpose: a cover is public content, and signing it
    # would mean one expiring signature per card in an Explore grid, none of which any cache
    # could ever reuse. This is safe only because it serves a *different* root — a public
    # location over /data/blobs would hand out every build to anyone who learned a hash.
    #
    # A regex location rather than a prefix one, so the only paths that resolve at all are the
    # ones the API can actually have written: two levels of hex fan-out, a hashed name, and one
    # of the three formats it stores. Anything else falls through to the 404 below.
    location ~ "^/media/([0-9a-f]{2})/([0-9a-f]{2})/([0-9a-f]{64}\.(?:png|jpg|webp))$" {
        alias /data/media/$1/$2/$3;

        # Named after the hash of its own contents, so it can never change.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        # Nothing stored here is ever a document, and this is what keeps a browser from being
        # talked into treating one as one.
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;

        sendfile   on;
        tcp_nopush on;
    }

    # Launcher releases. A third root, public and unsigned like the artwork above and for a
    # sharper version of the same reason: a launcher binary is the most public thing this
    # deployment holds, and the client asking for it has no token to be handed a signed URL
    # with — the launcher that most needs an update is the one that cannot sign in yet.
    #
    # Serving it unsigned weakens nothing. The integrity guarantee comes from a signature over
    # the release document and the content address inside it, neither of which a URL takes part
    # in: rewriting this URL entirely would still leave an attacker having to produce bytes that
    # hash to something somebody signed.
    #
    # A regex location, so the only paths that resolve are ones the publish command can have
    # written: two levels of hex fan-out, a hashed name, and the one extension it stores.
    location ~ "^/launcher/([0-9a-f]{2})/([0-9a-f]{2})/([0-9a-f]{64}\.zip)$" {
        alias /data/launcher/$1/$2/$3;

        # Named after the hash of its own contents, so it can never change.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;

        # An archive is a download, never something a browser should try to render.
        default_type application/zip;
        add_header Content-Disposition "attachment" always;

        sendfile   on;
        tcp_nopush on;
        # A release is fetched whole by the launcher, but a resumed download still asks for one.
        max_ranges 64;
    }

    location / {
        return 404;
    }
}
